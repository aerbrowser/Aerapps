{
  "id": "memos",
  "version": "0.1.0",
  "hostAPI": 2,
  "dataSchema": 1,
  "platform": "macos-arm64",
  "name": "Memos",
  "upstreamVersion": "26.11.0",
  "repository": "usememos/memos",
  "license": "MIT",
  "runtime": {
    "type": "process",
    "executable": "bin/memos",
